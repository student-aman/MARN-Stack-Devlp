<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="/style.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body class="bg-gradient-to-br from-blue-50 to-purple-100 font-sans antialiased text-gray-800">
    <%- include('partials/header') %>

    <main class="container mx-auto px-4 py-8 md:py-12">
        <h1 class="text-4xl md:text-5xl font-extrabold text-center text-blue-800 mb-8 md:mb-12">
            <i class="fas fa-search text-blue-600 mr-4"></i>Search Results for "<span class="text-green-600"><%= query %></span>" in "<span class="text-purple-600"><%= location %></span>"
        </h1>

        <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
            <!-- Filters Column (Left) -->
            <div class="lg:col-span-1">
                <div class="bg-white p-6 rounded-2xl shadow-lg mb-8">
                    <h2 class="text-2xl font-bold text-gray-800 mb-6">Filters</h2>
                    <form action="/search-results" method="GET">
                        <input type="hidden" name="query" value="<%= query %>">
                        <input type="hidden" name="location" value="<%= location %>">

                        <div class="mb-6">
                            <label for="category" class="block text-gray-700 text-lg font-semibold mb-2">Category</label>
                            <select id="category" name="category" class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                                <option value="">All Categories</option>
                                <option value="Home Services">Home Services</option>
                                <option value="IT Services">IT Services</option>
                                <option value="Education">Education</option>
                                <option value="Health & Wellness">Health & Wellness</option>
                                <option value="Beauty & Personal Care">Beauty & Personal Care</option>
                            </select>
                        </div>

                        <div class="mb-6">
                            <label for="priceRange" class="block text-gray-700 text-lg font-semibold mb-2">Price Range</label>
                            <input type="range" id="priceRange" name="priceRange" min="0" max="50000" value="50000" class="w-full h-2 bg-blue-200 rounded-lg appearance-none cursor-pointer">
                            <span class="block text-sm text-gray-600 mt-2">Max Price: ₹<span id="maxPriceValue">50000</span></span>
                        </div>

                        <div class="mb-6">
                            <label class="block text-gray-700 text-lg font-semibold mb-2">Rating</label>
                            <div class="space-y-2">
                                <label class="flex items-center text-gray-700">
                                    <input type="radio" name="rating" value="5" class="form-radio text-blue-600 h-4 w-4">
                                    <span class="ml-2">5 Stars</span>
                                </label>
                                <label class="flex items-center text-gray-700">
                                    <input type="radio" name="rating" value="4" class="form-radio text-blue-600 h-4 w-4">
                                    <span class="ml-2">4+ Stars</span>
                                </label>
                                <label class="flex items-center text-gray-700">
                                    <input type="radio" name="rating" value="3" class="form-radio text-blue-600 h-4 w-4">
                                    <span class="ml-2">3+ Stars</span>
                                </label>
                            </div>
                        </div>

                        <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-4 rounded-lg transition-colors duration-300 shadow-md">
                            Apply Filters
                        </button>
                    </form>
                </div>
            </div>

            <!-- Search Results Column (Right) -->
            <div class="lg:col-span-3">
                <div class="flex justify-between items-center mb-6">
                    <p class="text-lg font-semibold text-gray-700"><%= services.length %> services found</p>
                    <div>
                        <label for="sort" class="mr-2 text-gray-700">Sort By:</label>
                        <select id="sort" name="sort" class="p-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                            <option value="relevance">Relevance</option>
                            <option value="price_low_to_high">Price: Low to High</option>
                            <option value="price_high_to_low">Price: High to Low</option>
                            <option value="rating_high_to_low">Rating: High to Low</option>
                        </select>
                    </div>
                </div>

                <div class="space-y-6">
                    <% if (services && services.length > 0) { %>
                        <% services.forEach(service => { %>
                            <a href="/service/<%= service._id %>" 
                               class="flex flex-col text-center bg-white rounded-2xl shadow-lg transition-transform duration-200 hover:-translate-y-1 hover:shadow-xl overflow-hidden md:flex-row md:text-left">
                                <img src="<%= service.imageUrl || 'https://placehold.co/400x225/E0F2F7/0284C7?text=Service+Image' %>" 
                                     alt="<%= service.title %>" 
                                     class="w-full h-52 object-cover object-center md:w-64 md:h-auto md:rounded-tr-none md:rounded-bl-2xl rounded-t-2xl">
                                <div class="flex flex-col justify-between p-6 flex-grow">
                                    <div>
                                        <h2 class="text-2xl font-bold text-blue-800 mb-2"><%= service.title %></h2>
                                        <p class="text-gray-700 text-base mb-3"><%= service.description.substring(0, 100) %><% if (service.description.length > 100) { %>...<% } %></p>
                                        
                                        <div class="flex items-center text-amber-500 mb-3">
                                            <div class="text-lg mr-2 flex">
                                                <% for(let i = 0; i < Math.floor(service.rating || 4.0); i++) { %>
                                                    <i class="fas fa-star"></i>
                                                <% } %>
                                                <% if (service.rating && service.rating % 1 !== 0) { %>
                                                    <i class="fas fa-star-half-alt"></i>
                                                <% } %>
                                                <% for(let i = 0; i < (5 - Math.ceil(service.rating || 4.0)); i++) { %>
                                                    <i class="far fa-star text-gray-300"></i>
                                                <% } %>
                                            </div>
                                            <span class="text-gray-700 font-semibold"><%= service.rating || '4.0' %></span>
                                            <span class="text-gray-500 text-sm ml-2">(<%= service.reviewsCount || '0' %> Reviews)</span>
                                        </div>
                                    </div>
                                    <div class="mt-auto pt-4 border-t border-gray-200 flex justify-between items-center">
                                        <div class="flex items-center">
                                            <img src="<%= service.vendorImage || 'https://placehold.co/40x40/D1E9F9/2196F3?text=V' %>" 
                                                 alt="<%= service.vendorName %>" class="w-10 h-10 rounded-full object-cover object-center mr-3 border border-gray-200">
                                            <div>
                                                <p class="text-gray-800 font-semibold text-sm"><%= service.vendorName || 'Unknown Vendor' %></p>
                                                <p class="text-gray-600 text-xs"><%= service.vendorExpertise || 'Provider' %></p>
                                            </div>
                                        </div>
                                        <p class="text-blue-800 font-bold text-xl">₹<%= service.price || '0' %></p>
                                    </div>
                                </div>
                            </a>
                        <% }); %>
                    <% } else { %>
                        <div class="bg-white p-8 rounded-xl shadow-lg text-center text-gray-600 text-xl">
                            <i class="fas fa-exclamation-circle text-red-500 mb-4 text-4xl"></i>
                            <p>Koi service nahi mili jo aapke search criteria se match karti ho.</p>
                            <p class="mt-4">Kripya apna search ya filters badal kar phir se koshish karein.</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>

    <script>
        // Update Max Price Value display
        const priceRangeInput = document.getElementById('priceRange');
        const maxPriceValueSpan = document.getElementById('maxPriceValue');
        if (priceRangeInput && maxPriceValueSpan) {
            priceRangeInput.addEventListener('input', () => {
                maxPriceValueSpan.textContent = priceRangeInput.value;
            });
        }
    </script>
</body>
</html>
