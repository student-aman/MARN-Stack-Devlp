<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <!-- Tailwind CSS CDN (if not already included in style.css or using PostCSS) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="/style.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <!-- Google Fonts - Inter for a modern look -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
        /* Custom styling for inputs to make them pop more */
        input[type="text"],
        input[type="email"],
        input[type="tel"],
        input[type="date"],
        textarea {
            transition: all 0.2s ease-in-out;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06); /* subtle shadow */
        }
        input[type="text"]:focus,
        input[type="email"]:focus,
        input[type="tel"]:focus,
        input[type="date"]:focus,
        textarea:focus {
            outline: none;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.45), 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06); /* blue focus ring */
            border-color: #3B82F6; /* blue border */
        }
    </style>
</head>
<body class="bg-gradient-to-br from-blue-50 to-indigo-100 font-sans antialiased text-gray-800">

    <%- include('partials/header', { currentUser: currentUser }) %>

    <main class="container mx-auto px-4 py-12 md:py-16">
        <div class="max-w-4xl mx-auto bg-white p-8 md:p-10 rounded-2xl shadow-2xl border border-blue-100 transform transition-all duration-300 hover:shadow-3xl">
            
            <h1 class="text-4xl md:text-5xl font-extrabold text-center text-blue-800 mb-6 flex items-center justify-center">
                <i class="fas fa-calendar-check mr-4 text-blue-600"></i> Service Booking Form
            </h1>
            <p class="text-xl text-center text-gray-600 mb-10">
                Please fill in your details for the service of your choice.
            </p>

            <!-- Service Summary Card (Optional, but good for context) -->
            <div class="bg-blue-50 border border-blue-200 rounded-lg p-6 mb-8 flex flex-col md:flex-row items-center space-y-4 md:space-y-0 md:space-x-6 shadow-inner">
                <img src="<%= service.imageUrl %>" alt="<%= service.title %>" class="w-24 h-24 object-cover rounded-full border-4 border-blue-400 shadow-md">
                <div class="text-center md:text-left">
                    <h2 class="text-2xl font-bold text-blue-800 mb-1"><%= service.title %></h2>
                    <p class="text-gray-700 text-lg">By: <span class="font-semibold"><%= service.vendorName %></span></p>
                    <p class="text-green-700 text-xl font-bold mt-2">Price: ₹<%= service.price.toLocaleString('en-IN') %></p>
                </div>
                <div class="ml-auto text-center md:text-right">
                    <a href="/service/<%= service.id %>" class="text-blue-600 hover:text-blue-800 font-semibold text-md flex items-center">
                        <i class="fas fa-info-circle mr-2"></i> View Service Details
                    </a>
                </div>
            </div>

            <form action="/book-service" method="POST" class="space-y-6">
                <!-- Hidden input fields to send service details -->
                <input type="hidden" name="serviceId" value="<%= service.id %>">
                <input type="hidden" name="serviceTitle" value="<%= service.title %>">
                <input type="hidden" name="vendorName" value="<%= service.vendorName %>">

                <!-- Personal Details Section -->
                <div class="bg-gray-50 p-6 rounded-lg border border-gray-200 shadow-sm">
                    <h3 class="text-2xl font-bold text-gray-800 mb-6 border-b pb-3">Personal Details</h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label for="fullName" class="block text-md font-medium text-gray-700 mb-2">Full Name <span class="text-red-500">*</span></label>
                            <input type="text" id="fullName" name="fullName" class="w-full p-3 border border-gray-300 rounded-lg" placeholder="Your Full Name" required>
                        </div>
                        <div>
                            <label for="email" class="block text-md font-medium text-gray-700 mb-2">Email <span class="text-red-500">*</span></label>
                            <input type="email" id="email" name="email" class="w-full p-3 border border-gray-300 rounded-lg" placeholder="Your Email Address" required>
                        </div>
                        <div>
                            <label for="phone" class="block text-md font-medium text-gray-700 mb-2">Phone Number <span class="text-red-500">*</span></label>
                            <input type="tel" id="phone" name="phone" class="w-full p-3 border border-gray-300 rounded-lg" placeholder="e.g. +91-9876543210" required>
                        </div>
                        <div>
                            <label for="preferredDate" class="block text-md font-medium text-gray-700 mb-2">Preferred Date <span class="text-red-500">*</span></label>
                            <input type="date" id="preferredDate" name="preferredDate" class="w-full p-3 border border-gray-300 rounded-lg" required>
                        </div>
                    </div>
                </div>

                <!-- Service Requirements Section -->
                <div class="bg-gray-50 p-6 rounded-lg border border-gray-200 shadow-sm">
                    <h3 class="text-2xl font-bold text-gray-800 mb-6 border-b pb-3">Service Requirements</h3>
                    <div>
                        <label for="message" class="block text-md font-medium text-gray-700 mb-2">Your Message / Requirements</label>
                        <textarea id="message" name="message" rows="6" class="w-full p-3 border border-gray-300 rounded-lg" placeholder="Please provide details about your needs, such as the type of work, any special instructions, or availability..."></textarea>
                    </div>
                </div>
                
                <!-- Submit Button -->
                <button type="submit" class="w-full bg-gradient-to-r from-green-500 to-green-700 text-white font-bold py-4 rounded-lg shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 hover:scale-102 flex items-center justify-center text-xl">
                    <i class="fas fa-paper-plane mr-3"></i> Submit Inquiry
                </button>
            </form>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
