<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- NEW: Font Awesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        /* Using a more modern font like Poppins */
        body { font-family: 'Poppins', sans-serif; }

        /* Custom focus ring color */
        .form-input:focus, .form-textarea:focus {
            outline: none;
            border-color: #4f46e5; /* Indigo */
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.2);
        }
    </style>
</head>
<body class="bg-gray-50 text-gray-800 antialiased">
    
    <%- include('partials/header') %>

    <main class="min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
        <div class="container mx-auto">
            <div class="max-w-5xl mx-auto bg-white rounded-2xl shadow-2xl overflow-hidden md:flex">
                
                <!-- Left Side: Contact Info & Illustration -->
                <div class="w-full md:w-2/5 bg-gradient-to-br from-indigo-600 to-purple-600 p-8 md:p-12 text-white flex flex-col justify-between">
                    <div>
                        <h2 class="text-3xl font-bold mb-4">Connect With Us</h2>
                        <p class="text-indigo-100 mb-8">
                            Do you have a project or just want to say "Hi"? We would love to hear from you.
                        </p>
                        <ul class="space-y-4 text-indigo-100">
                            <li class="flex items-start">
                                <i class="fas fa-map-marker-alt w-6 mt-1"></i>
                                <span>123 Tech Avenue, Innovation City, IN</span>
                            </li>
                            <li class="flex items-start">
                                <i class="fas fa-phone w-6 mt-1"></i>
                                <span>+91 98765 43210</span>
                            </li>
                            <li class="flex items-start">
                                <i class="fas fa-envelope w-6 mt-1"></i>
                                <span>contact@yourcompany.com</span>
                            </li>
                        </ul>
                    </div>
                    <div class="mt-8 text-center md:text-left">
                        <p class="font-light">Follow us on:</p>
                        <div class="flex space-x-4 mt-2 justify-center md:justify-start">
                            <a href="#" class="text-indigo-200 hover:text-white transition-colors"><i class="fab fa-facebook-f fa-lg"></i></a>
                            <a href="#" class="text-indigo-200 hover:text-white transition-colors"><i class="fab fa-twitter fa-lg"></i></a>
                            <a href="#" class="text-indigo-200 hover:text-white transition-colors"><i class="fab fa-instagram fa-lg"></i></a>
                            <a href="#" class="text-indigo-200 hover:text-white transition-colors"><i class="fab fa-linkedin-in fa-lg"></i></a>
                        </div>
                    </div>
                </div>

                <!-- Right Side: Contact Form -->
                <div class="w-full md:w-3/5 p-8 md:p-12">
                    <h2 class="text-3xl font-bold text-gray-900 mb-2">Send Us a Message</h2>
                    <p class="text-gray-600 mb-8">We will get back to you within 24 hours.</p>

                    <% if (successMessage) { %>
                        <div class="bg-green-100 border-l-4 border-green-500 text-green-700 p-4 rounded-md mb-6" role="alert">
                            <p class="font-bold">Success!</p>
                            <p><%= successMessage %></p>
                        </div>
                    <% } %>
                    <% if (errorMessage) { %>
                        <div class="bg-red-100 border-l-4 border-red-500 text-red-700 p-4 rounded-md mb-6" role="alert">
                            <p class="font-bold">Galti!</p>
                            <p><%= errorMessage %></p>
                        </div>
                    <% } %>

                    <form action="/contact" method="POST" class="space-y-6">
                        <!-- Name Input with Icon -->
                        <div>
                            <label for="fullName" class="hidden">Full Name</label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                    <i class="fas fa-user text-gray-400"></i>
                                </div>
                                <input type="text" id="fullName" name="fullName" class="form-input block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-md placeholder-gray-500 transition" placeholder="Full Name" value="<%= typeof formData !== 'undefined' ? formData.fullName : '' %>" required>
                            </div>
                        </div>
                        
                        <!-- Email Input with Icon -->
                        <div>
                            <label for="email" class="hidden">Email</label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                    <i class="fas fa-envelope text-gray-400"></i>
                                </div>
                                <input type="email" id="email" name="email" class="form-input block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-md placeholder-gray-500 transition" placeholder="Email Address" value="<%= typeof formData !== 'undefined' ? formData.email : '' %>" required>
                            </div>
                        </div>

                        <!-- Subject Input with Icon -->
                        <div>
                            <label for="subject" class="hidden">Vishay</label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                    <i class="fas fa-pen-nib text-gray-400"></i>
                                </div>
                                <input type="text" id="subject" name="subject" class="form-input block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-md placeholder-gray-500 transition" placeholder="Vishay" value="<%= typeof formData !== 'undefined' ? formData.subject : '' %>" required>
                            </div>
                        </div>
                        
                        <!-- Message Textarea with Icon -->
                        <div>
                            <label for="message" class="hidden">Sandesh</label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 top-0 pt-2 pl-3 flex items-start pointer-events-none">
                                    <i class="fas fa-comment-dots text-gray-400"></i>
                                </div>
                                <textarea id="message" name="message" rows="5" class="form-textarea block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-md placeholder-gray-500 transition" placeholder="Aapka sandesh yahan likhein..." required><%= typeof formData !== 'undefined' ? formData.message : '' %></textarea>
                            </div>
                        </div>
                        
                        <!-- Submit Button -->
                        <div>
                            <button type="submit" class="w-full flex justify-center py-3 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-transform transform hover:scale-105">
                                <i class="fas fa-paper-plane ml-2"></i> Send Message
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>

</body>
</html>