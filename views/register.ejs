<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body class="font-['Inter',sans-serif] bg-blue-600 flex justify-center items-center min-h-screen m-0 overflow-hidden">
    <div class="bg-white p-10 rounded-3xl shadow-2xl max-w-sm w-11/12 text-center relative z-10">
        <h2 class="text-3xl font-bold text-gray-800 mb-6">Register Karein</h2>

        <% if (successMessage) { %>
            <div class="mb-6 px-4 py-3 rounded-lg text-green-800 bg-green-100 border border-green-400 font-medium text-base">
                <%= successMessage %>
            </div>
        <% } %>
        <% if (errorMessage) { %>
            <div class="mb-6 px-4 py-3 rounded-lg text-red-700 bg-red-100 border border-red-400 font-medium text-base">
                <%= errorMessage %>
            </div>
        <% } %>

        <form action="/register" method="POST">
            <div class="relative mb-6">
                <i class="fas fa-user absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-lg"></i>
                <input type="text" id="name" name="name" placeholder="Poora Naam"
                    value="<%= typeof name !== 'undefined' ? name : '' %>"
                    required
                    class="w-full pl-11 pr-4 py-3 border border-slate-300 rounded-xl text-base text-gray-800 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-200 transition"
                >
            </div>
            <div class="relative mb-6">
                <i class="fas fa-envelope absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-lg"></i>
                <input type="email" id="email" name="email" placeholder="Email Address"
                    value="<%= typeof email !== 'undefined' ? email : '' %>"
                    required
                    class="w-full pl-11 pr-4 py-3 border border-slate-300 rounded-xl text-base text-gray-800 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-200 transition"
                >
            </div>
            <div class="relative mb-6">
                <i class="fas fa-lock absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-lg"></i>
                <input type="password" id="password" name="password" placeholder="Password" required
                    class="w-full pl-11 pr-12 py-3 border border-slate-300 rounded-xl text-base text-gray-800 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-200 transition"
                >
                <button type="button" id="togglePassword"
                    class="absolute right-3 top-1/2 -translate-y-1/2 flex items-center text-gray-500 hover:text-gray-700">
                    <i class="fas fa-eye"></i>
                </button>
            </div>
            <div class="relative mb-6">
                <i class="fas fa-lock absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-lg"></i>
                <input type="password" id="password2" name="password2" placeholder="Password Confirm Karein" required
                    class="w-full pl-11 pr-12 py-3 border border-slate-300 rounded-xl text-base text-gray-800 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-200 transition"
                >
                <button type="button" id="togglePassword2"
                    class="absolute right-3 top-1/2 -translate-y-1/2 flex items-center text-gray-500 hover:text-gray-700">
                    <i class="fas fa-eye"></i>
                </button>
            </div>
            
            <button type="submit"
                class="w-full bg-blue-500 text-white font-semibold py-4 rounded-xl transition hover:bg-blue-600 hover:-translate-y-0.5 shadow-md hover:shadow-lg border-0 cursor-pointer"
            >REGISTER</button>
        </form>

        <div class="mt-8 text-center text-sm text-gray-600">
            <p>Go to the Home Page <a href="/" class="font-medium text-blue-600 hover:underline">Go Back Home</a></p>
        </div>
    </div>

    <!-- JavaScript for Password Toggles -->
    <script>
        // For first password field
        const togglePassword = document.getElementById('togglePassword');
        const password = document.getElementById('password');
        const toggleIcon = togglePassword ? togglePassword.querySelector('i') : null;

        if (togglePassword) {
            togglePassword.addEventListener('click', function () {
                const type = password.getAttribute('type') === 'password' ? 'text' : 'password';
                password.setAttribute('type', type);
                if (toggleIcon) {
                    toggleIcon.classList.toggle('fa-eye');
                    toggleIcon.classList.toggle('fa-eye-slash');
                }
            });
        }

        // For second password field (Confirm Password)
        const togglePassword2 = document.getElementById('togglePassword2');
        const password2 = document.getElementById('password2');
        const toggleIcon2 = togglePassword2 ? togglePassword2.querySelector('i') : null;

        if (togglePassword2) {
            togglePassword2.addEventListener('click', function () {
                const type = password2.getAttribute('type') === 'password' ? 'text' : 'password';
                password2.setAttribute('type', type);
                if (toggleIcon2) {
                    toggleIcon2.classList.toggle('fa-eye');
                    toggleIcon2.classList.toggle('fa-eye-slash');
                }
            });
        }
    </script>
</body>
</html>
