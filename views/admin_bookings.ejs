<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="/style.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body class="bg-gradient-to-br from-blue-50 to-red-100 font-sans antialiased text-gray-800">
    <%- include('partials/header', { currentUser: currentUser }) %>

    <main class="container mx-auto px-4 py-12 md:py-16">
        <div class="max-w-7xl mx-auto bg-white p-8 md:p-10 rounded-2xl shadow-xl border border-blue-100">
            <h1 class="text-4xl md:text-5xl font-extrabold text-center text-red-700 mb-8 flex items-center justify-center">
                <i class="fas fa-calendar-alt mr-4 text-red-500"></i> Manage Bookings
            </h1>
            <p class="text-lg text-center text-gray-600 mb-10">
                List of all customer service bookings.
            </p>

            <% if (successMessage) { %>
                <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded-lg relative mb-6" role="alert">
                    <strong class="font-bold">Success!</strong>
                    <span class="block sm:inline"><%= successMessage %></span>
                </div>
            <% } %>
            <% if (errorMessage) { %>
                <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-lg relative mb-6" role="alert">
                    <strong class="font-bold">Error!</strong>
                    <span class="block sm:inline"><%= errorMessage %></span>
                </div>
            <% } %>

            <div class="overflow-x-auto rounded-lg border border-gray-200 bg-white shadow-md">
                <table class="min-w-full border-collapse">
                    <thead>
                        <tr>
                            <th class="px-4 py-4 bg-gray-50 font-semibold text-gray-700 uppercase text-sm border-b">#</th>
                            <th class="px-4 py-4 bg-gray-50 font-semibold text-gray-700 uppercase text-sm border-b">Service</th>
                            <th class="px-4 py-4 bg-gray-50 font-semibold text-gray-700 uppercase text-sm border-b">Vendor</th>
                            <th class="px-4 py-4 bg-gray-50 font-semibold text-gray-700 uppercase text-sm border-b">Customer</th>
                            <th class="px-4 py-4 bg-gray-50 font-semibold text-gray-700 uppercase text-sm border-b">Preferred Date</th>
                            <th class="px-4 py-4 bg-gray-50 font-semibold text-gray-700 uppercase text-sm border-b">Status</th>
                            <th class="px-4 py-4 bg-gray-50 font-semibold text-gray-700 uppercase text-sm border-b">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (bookings && bookings.length > 0) { %>
                            <% bookings.forEach(function(booking, index) { %>
                                <tr class="hover:bg-gray-50 transition-colors duration-200">
                                    <td class="px-4 py-4 border-b"><%= index + 1 %></td>
                                    <td class="px-4 py-4 border-b"><%= booking.serviceTitle %></td>
                                    <td class="px-4 py-4 border-b"><%= booking.vendorName %></td>
                                    <td class="px-4 py-4 border-b"><%= booking.customerName %></td>
                                    <td class="px-4 py-4 border-b"><%= new Date(booking.preferredDate).toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric' }) %></td>
                                    <td class="px-4 py-4 border-b">
                                        <span class="px-3 py-1 rounded-full text-xs font-semibold
                                            <% if (booking.status === 'Confirmed') { %> bg-green-200 text-green-800 <% }
                                            else if (booking.status === 'Pending') { %> bg-yellow-200 text-yellow-800 <% }
                                            else if (booking.status === 'Cancelled') { %> bg-red-200 text-red-800 <% }
                                            else if (booking.status === 'Completed') { %> bg-purple-200 text-purple-800 <% } %>">
                                            <%= booking.status %>
                                        </span>
                                    </td>
                                    <td class="px-4 py-4 border-b">
                                        <div class="flex items-center space-x-2">
                                            <!-- Edit Button (redirects to edit page) -->
                                            <a href="/admin/bookings/edit/<%= booking._id %>" class="bg-blue-500 hover:bg-blue-600 text-white px-3 py-1 rounded-md text-sm transition-colors flex items-center">
                                                <i class="fas fa-edit mr-1"></i> Edit
                                            </a>
                                            <!-- Delete Form (using POST for deletion with method override) -->
                                            <form action="/admin/bookings/delete/<%= booking._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Are you sure you want to delete this booking? This action cannot be undone!');">
                                                <button type="submit" class="bg-red-500 hover:bg-red-600 text-white px-3 py-1 rounded-md text-sm transition-colors flex items-center">
                                                    <i class="fas fa-trash-alt mr-1"></i> Delete
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="7" class="text-center py-8 text-gray-600">No bookings found.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <div class="mt-8 text-center">
                <a href="/admin" class="inline-block bg-gray-200 text-gray-700 font-bold py-2 px-6 rounded-full hover:bg-gray-300 transition-colors">
                    <i class="fas fa-arrow-left mr-2"></i> Back to Dashboard
                </a>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
