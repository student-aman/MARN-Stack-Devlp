<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="/style.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body class="bg-gradient-to-br from-blue-50 to-green-100 font-sans antialiased text-gray-800">
    <%- include('partials/header', { currentUser: currentUser }) %>

    <main class="container mx-auto px-4 py-12 md:py-16">
        <div class="max-w-7xl mx-auto bg-white p-8 md:p-10 rounded-2xl shadow-xl border border-blue-100">
            <h1 class="text-4xl md:text-5xl font-extrabold text-center text-green-700 mb-8 flex items-center justify-center">
                <i class="fas fa-wrench mr-4 text-green-500"></i> Manage Services
            </h1>
            <p class="text-lg text-center text-gray-600 mb-10">
                List of all services listed on the website.
            </p>

            <% if (successMessage) { %>
                <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded-lg relative mb-6" role="alert">
                    <strong class="font-bold">Success!</strong>
                    <span class="block sm:inline"><%= successMessage %></span>
                </div>
            <% } %>
            <% if (errorMessage) { %>
                <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-lg relative mb-6" role="alert"></div>
                    <strong class="font-bold">Error!</strong>
                    <span class="block sm:inline"><%= errorMessage %></span>
                </div>
            <% } %>

            <div class="overflow-x-auto rounded-lg bg-white shadow-md border border-gray-200">
                <table class="min-w-full border-collapse">
                    <thead>
                        <tr>
                            <th class="px-4 py-3 bg-gray-50 font-semibold text-gray-700 uppercase text-sm border-b border-gray-200">#</th>
                            <th class="px-4 py-3 bg-gray-50 font-semibold text-gray-700 uppercase text-sm border-b border-gray-200">Title</th>
                            <th class="px-4 py-3 bg-gray-50 font-semibold text-gray-700 uppercase text-sm border-b border-gray-200">Category</th>
                            <th class="px-4 py-3 bg-gray-50 font-semibold text-gray-700 uppercase text-sm border-b border-gray-200">Vendor</th>
                            <th class="px-4 py-3 bg-gray-50 font-semibold text-gray-700 uppercase text-sm border-b border-gray-200">Price</th>
                            <th class="px-4 py-3 bg-gray-50 font-semibold text-gray-700 uppercase text-sm border-b border-gray-200">Rating</th>
                            <th class="px-4 py-3 bg-gray-50 font-semibold text-gray-700 uppercase text-sm border-b border-gray-200">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (services && services.length > 0) { %>
                            <% services.forEach(function(service, index) { %>
                                <tr class="hover:bg-gray-50 transition-colors duration-200">
                                    <td class="px-4 py-4 border-b border-gray-200"><%= index + 1 %></td>
                                    <td class="px-4 py-4 border-b border-gray-200"><%= service.title %></td>
                                    <td class="px-4 py-4 border-b border-gray-200">
                                        <span class="px-3 py-1 rounded-full text-xs font-semibold bg-gray-200 text-gray-800">
                                            <%= service.category.charAt(0).toUpperCase() + service.category.slice(1).replace('-', ' ') %>
                                        </span>
                                    </td>
                                    <td class="px-4 py-4 border-b border-gray-200"><%= service.vendorName %></td>
                                    <td class="px-4 py-4 border-b border-gray-200">₹<%= service.price.toLocaleString('en-IN') %></td>
                                    <td class="px-4 py-4 border-b border-gray-200"><%= service.rating %> (<%= service.reviewsCount %>)</td>
                                    <td class="px-4 py-4 border-b border-gray-200">
                                        <div class="flex items-center space-x-2">
                                            <a href="/admin/services/edit/<%= service._id %>" class="bg-blue-500 hover:bg-blue-600 text-white px-3 py-1 rounded-md text-sm transition-colors flex items-center">
                                                <i class="fas fa-edit mr-1"></i> Edit
                                            </a>
                                            <form action="/admin/services/delete/<%= service._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Are you sure you want to delete this service? This action cannot be undone!');">
                                                <button type="submit" class="bg-red-500 hover:bg-red-600 text-white px-3 py-1 rounded-md text-sm transition-colors flex items-center">
                                                    <i class="fas fa-trash-alt mr-1"></i> Delete
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="7" class="text-center py-8 text-gray-600">No services found.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <div class="mt-8 text-center">
                <a href="/admin" class="inline-block bg-gray-200 text-gray-700 font-bold py-2 px-6 rounded-full hover:bg-gray-300 transition-colors">
                    <i class="fas fa-arrow-left mr-2"></i> Back to Admin Dashboard
                </a>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
