<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="/style.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body class="bg-gradient-to-br from-blue-50 to-purple-100 font-sans antialiased text-gray-800">
    <%- include('partials/header') %>

    <main class="container mx-auto px-4 py-8 md:py-12">
        <h1 class="text-4xl md:text-5xl font-extrabold text-center text-blue-800 mb-8 md:mb-12">
            Mera Profile
        </h1>

        <% if (successMessage) { %>
            <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded-md relative mb-6 max-w-xl mx-auto" role="alert">
                <strong class="font-bold">Success!</strong>
                <span class="block sm:inline"><%= successMessage %></span>
            </div>
        <% } %>
        <% if (errorMessage) { %>
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-md relative mb-6 max-w-xl mx-auto" role="alert">
                <strong class="font-bold">Error!</strong>
                <span class="block sm:inline"><%= errorMessage %></span>
            </div>
        <% } %>

        <div class="max-w-xl mx-auto bg-white p-10 rounded-3xl shadow-xl border border-gray-200 transition-transform duration-300 hover:-translate-y-1 hover:shadow-2xl">
            <div class="flex flex-col items-center mb-8">
                <i class="fas fa-user-circle text-8xl text-blue-500 mb-4"></i>
                <h2 class="text-3xl font-bold text-gray-800"><%= user.name %></h2>
                <p class="text-gray-600 text-md mt-1">Role: <span class="capitalize"><%= user.role %></span></p>
            </div>

            <div class="border-t border-gray-200 pt-8 mt-8">
                <h3 class="text-2xl font-semibold text-gray-800 mb-6">Personal Details</h3>
                
                <div class="flex items-center mb-4">
                    <i class="fas fa-envelope text-2xl text-blue-500 mr-4 w-8 text-center"></i>
                    <span class="text-lg text-gray-700"><strong class="text-gray-900 font-semibold mr-2">Email:</strong> <%= user.email %></span>
                </div>
                
                <!-- Add more profile details here if available in your User model -->
                <!-- Example: -->
                <!-- <div class="flex items-center mb-4">
                    <i class="fas fa-phone text-2xl text-blue-500 mr-4 w-8 text-center"></i>
                    <span class="text-lg text-gray-700"><strong class="text-gray-900 font-semibold mr-2">Phone:</strong> <%= user.phone || 'N/A' %></span>
                </div>
                <div class="flex items-center mb-4">
                    <i class="fas fa-map-marker-alt text-2xl text-blue-500 mr-4 w-8 text-center"></i>
                    <span class="text-lg text-gray-700"><strong class="text-gray-900 font-semibold mr-2">Address:</strong> <%= user.address || 'N/A' %></span>
                </div> -->

            </div>

            <div class="mt-10 text-center">
                <a href="/profile/edit" class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-8 rounded-full shadow-lg transition-all duration-300 transform hover:scale-105">
                    Profile Edit Karein
                </a>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
