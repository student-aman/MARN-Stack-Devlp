<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="/style.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body class="bg-gradient-to-br from-blue-50 to-indigo-100 font-sans antialiased text-gray-800">
    <%- include('partials/header', { currentUser: currentUser }) %>

    <main class="container mx-auto px-4 py-12 md:py-16">
        <div class="max-w-7xl mx-auto bg-white p-8 md:p-10 rounded-2xl shadow-xl border border-blue-100">
            <h1 class="text-4xl md:text-5xl font-extrabold text-center text-indigo-700 mb-8 flex items-center justify-center">
                <i class="fas fa-handshake mr-4 text-indigo-500"></i> Manage Vendors
            </h1>
            <p class="text-lg text-center text-gray-600 mb-10">
                List of all vendors registered on SkillHub.
            </p>

            <% if (successMessage) { %>
                <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded-lg relative mb-6" role="alert">
                    <strong class="font-bold">Success!</strong>
                    <span class="block sm:inline"><%= successMessage %></span>
                </div>
            <% } %>
            <% if (errorMessage) { %>
                <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-lg relative mb-6" role="alert">
                    <strong class="font-bold">Error!</strong>
                    <span class="block sm:inline"><%= errorMessage %></span>
                </div>
            <% } %>

            <div class="overflow-x-auto rounded-lg bg-white shadow-md border border-gray-200">
                <table class="min-w-full border-collapse">
                    <thead>
                        <tr>
                            <th class="px-4 py-4 bg-gray-50 font-semibold text-gray-700 uppercase text-sm border-b border-gray-200">#</th>
                            <th class="px-4 py-4 bg-gray-50 font-semibold text-gray-700 uppercase text-sm border-b border-gray-200">Company</th>
                            <th class="px-4 py-4 bg-gray-50 font-semibold text-gray-700 uppercase text-sm border-b border-gray-200">Contact Person</th>
                            <th class="px-4 py-4 bg-gray-50 font-semibold text-gray-700 uppercase text-sm border-b border-gray-200">Email</th>
                            <th class="px-4 py-4 bg-gray-50 font-semibold text-gray-700 uppercase text-sm border-b border-gray-200">Phone</th>
                            <th class="px-4 py-4 bg-gray-50 font-semibold text-gray-700 uppercase text-sm border-b border-gray-200">Category</th>
                            <th class="px-4 py-4 bg-gray-50 font-semibold text-gray-700 uppercase text-sm border-b border-gray-200">Status</th>
                            <th class="px-4 py-4 bg-gray-50 font-semibold text-gray-700 uppercase text-sm border-b border-gray-200">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (vendors && vendors.length > 0) { %>
                            <% vendors.forEach(function(vendor, index) { %>
                                <tr class="hover:bg-gray-50 transition-colors duration-200">
                                    <td class="px-4 py-4 border-b border-gray-200"><%= index + 1 %></td>
                                    <td class="px-4 py-4 border-b border-gray-200"><%= vendor.companyName %></td>
                                    <td class="px-4 py-4 border-b border-gray-200"><%= vendor.contactPerson %></td>
                                    <td class="px-4 py-4 border-b border-gray-200"><%= vendor.email %></td>
                                    <td class="px-4 py-4 border-b border-gray-200"><%= vendor.phone %></td>
                                    <td class="px-4 py-4 border-b border-gray-200">
                                        <span class="px-3 py-1 rounded-full text-xs font-semibold bg-gray-200 text-gray-800">
                                            <%= vendor.serviceCategory %>
                                        </span>
                                    </td>
                                    <td class="px-4 py-4 border-b border-gray-200">
                                        <span class="px-3 py-1 rounded-full text-xs font-semibold
                                            <% if (vendor.status === 'Approved') { %> bg-green-200 text-green-800 <% }
                                            else if (vendor.status === 'Pending Review') { %> bg-yellow-200 text-yellow-800 <% }
                                            else { %> bg-red-200 text-red-800 <% } %>">
                                            <%= vendor.status %>
                                        </span>
                                    </td>
                                    <td class="px-4 py-4 border-b border-gray-200">
                                        <div class="flex items-center space-x-2 flex-wrap gap-2">
                                            <!-- Edit Button (redirects to edit page) -->
                                            <a href="/admin/vendors/edit/<%= vendor._id %>" class="bg-blue-500 hover:bg-blue-600 text-white px-3 py-1 rounded-md text-sm transition-colors flex items-center">
                                                <i class="fas fa-edit mr-1"></i> एडिट
                                            </a>
                                            <!-- Approve Button (only if status is not Approved) -->
                                            <% if (vendor.status !== 'Approved') { %>
                                                <form action="/admin/vendors/status/<%= vendor._id %>?_method=PUT" method="POST" onsubmit="return confirm('Are you sure you want to approve this vendor?');" class="inline-block">
                                                    <input type="hidden" name="status" value="Approved">
                                                    <button type="submit" class="bg-green-500 hover:bg-green-600 text-white px-3 py-1 rounded-md text-sm transition-colors flex items-center">
                                                        <i class="fas fa-check mr-1"></i> Approve
                                                    </button>
                                                </form>
                                            <% } %>
                                            <!-- Reject Button (only if status is not Rejected) -->
                                            <% if (vendor.status !== 'Rejected') { %>
                                                <form action="/admin/vendors/status/<%= vendor._id %>?_method=PUT" method="POST" onsubmit="return confirm('Are you sure you want to reject this vendor?');" class="inline-block">
                                                    <input type="hidden" name="status" value="Rejected">
                                                    <button type="submit" class="bg-orange-500 hover:bg-orange-600 text-white px-3 py-1 rounded-md text-sm transition-colors flex items-center">
                                                        <i class="fas fa-times mr-1"></i> Reject
                                                    </button>
                                                </form>
                                            <% } %>
                                            <!-- Delete Button (using POST for deletion with method override) -->
                                            <form action="/admin/vendors/delete/<%= vendor._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Are you sure you want to delete this vendor? This action cannot be undone!');" class="inline-block">
                                                <button type="submit" class="bg-red-500 hover:bg-red-600 text-white px-3 py-1 rounded-md text-sm transition-colors flex items-center">
                                                    <i class="fas fa-trash-alt mr-1"></i> Delete
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="8" class="text-center py-8 text-gray-600">No vendors found.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <div class="mt-8 text-center">
                <a href="/admin" class="inline-block bg-gray-200 text-gray-700 font-bold py-2 px-6 rounded-full hover:bg-gray-300 transition-colors">
                    <i class="fas fa-arrow-left mr-2"></i> Back to Dashboard
                </a>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
