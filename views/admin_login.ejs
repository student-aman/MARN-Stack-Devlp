<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body class="bg-blue-700 flex justify-center items-center min-h-screen font-inter antialiased text-gray-900 overflow-hidden">
    <div class="admin-login-container bg-white p-10 rounded-3xl shadow-2xl max-w-md w-full text-center relative z-10">
        <h2 class="text-3xl font-bold text-gray-800 mb-6">Admin Login</h2>

        <% if (successMessage) { %>
            <div class="message-box bg-green-100 border border-green-400 text-green-700 p-3 rounded-lg mb-6 text-sm font-medium">
                <%= successMessage %>
            </div>
        <% } %>
        <% if (errorMessage) { %>
            <div class="message-box bg-red-100 border border-red-400 text-red-700 p-3 rounded-lg mb-6 text-sm font-medium">
                <%= errorMessage %>
            </div>
        <% } %>

        <form action="/admin/login" method="POST">
            <div class="input-group relative mb-6">
                <i class="fas fa-envelope icon absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-lg"></i>
                <input type="email" id="email" name="email" class="w-full pl-12 pr-4 py-3 border border-gray-300 rounded-xl text-base text-gray-800 focus:outline-none focus:border-blue-600 focus:ring-2 focus:ring-blue-300" placeholder="Email Address" value="<%= typeof email !== 'undefined' ? email : '' %>" required>
            </div>
            <div class="input-group relative mb-6">
                <i class="fas fa-lock icon absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-lg"></i>
                <input type="password" id="password" name="password" class="w-full pl-12 pr-12 py-3 border border-gray-300 rounded-xl text-base text-gray-800 focus:outline-none focus:border-blue-600 focus:ring-2 focus:ring-blue-300" placeholder="Password" required>
                <!-- Password Toggle Button -->
                <button type="button" id="togglePassword" class="absolute inset-y-0 right-0 flex items-center px-3 text-gray-500 hover:text-gray-700">
                    <i class="fas fa-eye"></i>
                </button>
            </div>
            
            <button type="submit" class="login-button w-full bg-blue-600 text-white font-semibold py-4 rounded-xl shadow-lg hover:bg-blue-700 transition-all duration-300 transform hover:-translate-y-0.5">
                LOGIN
            </button>
        </form>

        <div class="mt-8 text-center text-sm text-gray-600">
            <br class="sm:hidden">If you're not an admin, please <a href="/" class="font-medium text-blue-600 hover:underline">Go back Home</a>.
            </p>
        </div>
    </div>

    <!-- JavaScript for Password Toggle -->
    <script>
        const togglePassword = document.getElementById('togglePassword');
        const password = document.getElementById('password');
        const toggleIcon = togglePassword.querySelector('i');

        if (togglePassword) { // Check if the button exists
            togglePassword.addEventListener('click', function () {
                const type = password.getAttribute('type') === 'password' ? 'text' : 'password';
                password.setAttribute('type', type);
                
                toggleIcon.classList.toggle('fa-eye');
                toggleIcon.classList.toggle('fa-eye-slash');
            });
        }
    </script>
</body>
</html>
