<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="/style.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body class="bg-gradient-to-br from-blue-50 to-purple-100 font-sans antialiased text-gray-800">
    <%- include('partials/header') %>

    <main class="container mx-auto px-4 py-8 md:py-12">
        <h1 class="text-4xl md:text-5xl font-extrabold text-center text-blue-800 mb-8 md:mb-12">Our Services</h1>
        <p class="text-xl text-center text-gray-600 mb-10 max-w-3xl mx-auto">
            Explore a wide range of professional services tailored to your needs. From home improvements to digital solutions, find the perfect expert for your task.
        </p>

        <% if (services && services.length > 0) { %>
            <div id="services-container" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
                <% services.forEach(service => { %>
                    <a href="/service/<%= service.id %>" 
                       class="rounded-2xl bg-white shadow-lg hover:shadow-2xl transition-transform duration-300 ease-in-out hover:-translate-y-1 flex flex-col overflow-hidden">
                        <img src="<%= service.imageUrl || 'https://placehold.co/600x400/CCCCCC/000000?text=No+Image' %>" 
                             alt="<%= service.title %>" 
                             class="w-full h-48 object-cover object-center rounded-t-2xl">
                        <div class="p-5 flex flex-col flex-grow">
                            <h2 class="text-xl font-semibold text-gray-800 mb-2 truncate"><%= service.title %></h2>
                            <p class="text-sm text-gray-600 mb-3 flex-grow line-clamp-3"><%= service.description %></p>
                            
                            <div class="flex items-center text-gray-700 mb-2">
                                <i class="fas fa-user-circle mr-2 text-blue-500"></i>
                                <span class="text-sm font-medium"><%= service.vendorName || 'Unknown Vendor' %></span>
                            </div>

                            <div class="flex items-center text-gray-700 mb-2">
                                <i class="fas fa-map-marker-alt mr-2 text-red-500"></i>
                                <span class="text-sm"><%= service.location || 'N/A' %></span>
                            </div>

                            <div class="flex items-center justify-between mt-auto pt-3 border-t border-gray-100">
                                <div class="flex items-center">
                                    <% 
                                        const rating = service.rating || 0;
                                        for (let i = 1; i <= 5; i++) {
                                            if (i <= Math.floor(rating)) {
                                    %>
                                            <i class="fas fa-star text-yellow-400"></i>
                                    <%      } else if (i - 0.5 === rating) { %>
                                            <i class="fas fa-star-half-alt text-yellow-400"></i>
                                    <%      } else { %>
                                            <i class="far fa-star text-gray-300"></i>
                                    <%      }
                                        }
                                    %>
                                    <span class="text-sm text-gray-600 ml-2">(<%= service.reviewsCount || 0 %> Reviews)</span>
                                </div>
                                <span class="text-lg font-bold text-blue-700">₹<%= service.price || '0' %></span>
                            </div>
                        </div>
                    </a>
                <% }); %>
            </div>

            <!-- "View More" Button (Conditional Display) -->
            <% if (services.length < totalCount) { %>
                <div class="text-center mt-10">
                    <button id="load-more-btn" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-8 rounded-full shadow-lg transition-all duration-300 transform hover:scale-105">
                        View More Services
                    </button>
                </div>
            <% } %>

        <% } else { %>
            <div class="text-center py-10 bg-white rounded-xl shadow-lg p-8">
                <p class="text-2xl text-gray-600">No services found at the moment. Please check back later!</p>
            </div>
        <% } %>
    </main>

    <%- include('partials/footer') %>

    <script>
        // JavaScript for "View More" functionality
        let currentSkip = <%= initialLimit || 0 %>; 
        const loadLimit = <%= LOAD_MORE_LIMIT || 4 %>; 
        const totalServices = <%= totalCount || 0 %>; 

        const loadMoreBtn = document.getElementById('load-more-btn');
        const servicesContainer = document.getElementById('services-container');

        function generateStarRatingHtml(rating, reviewsCount) {
            let starsHtml = '';
            for (let i = 1; i <= 5; i++) {
                if (i <= Math.floor(rating)) {
                    starsHtml += `<i class="fas fa-star text-yellow-400"></i>`;
                } else if (i - 0.5 === rating) {
                    starsHtml += `<i class="fas fa-star-half-alt text-yellow-400"></i>`;
                } else {
                    starsHtml += `<i class="far fa-star text-gray-300"></i>`;
                }
            }
            starsHtml += `<span class="text-sm text-gray-600 ml-2">(${reviewsCount} Reviews)</span>`;
            return starsHtml;
        }

        if (loadMoreBtn) {
            loadMoreBtn.addEventListener('click', async () => {
                loadMoreBtn.textContent = 'Loading...';
                loadMoreBtn.disabled = true;

                try {
                    const response = await fetch(`/api/services?skip=${currentSkip}&limit=${loadLimit}`);
                    const data = await response.json();

                    data.services.forEach(service => {
                        const serviceCardHtml = `
                            <a href="/service/${service.id}" class="rounded-2xl bg-white shadow-lg hover:shadow-2xl transition-transform duration-300 ease-in-out hover:-translate-y-1 flex flex-col overflow-hidden">
                                <img src="${service.imageUrl || 'https://placehold.co/600x400/CCCCCC/000000?text=No+Image'}" alt="${service.title}" class="w-full h-48 object-cover object-center rounded-t-2xl">
                                <div class="p-5 flex flex-col flex-grow">
                                    <h2 class="text-xl font-semibold text-gray-800 mb-2 truncate">${service.title}</h2>
                                    <p class="text-sm text-gray-600 mb-3 flex-grow line-clamp-3">${service.description}</p>
                                    
                                    <div class="flex items-center text-gray-700 mb-2">
                                        <i class="fas fa-user-circle mr-2 text-blue-500"></i>
                                        <span class="text-sm font-medium">${service.vendorName || 'Unknown Vendor'}</span>
                                    </div>

                                    <div class="flex items-center text-gray-700 mb-2">
                                        <i class="fas fa-map-marker-alt mr-2 text-red-500"></i>
                                        <span class="text-sm">${service.location || 'N/A'}</span>
                                    </div>

                                    <div class="flex items-center justify-between mt-auto pt-3 border-t border-gray-100">
                                        <div class="flex items-center">
                                            ${generateStarRatingHtml(service.rating || 0, service.reviewsCount || 0)}
                                        </div>
                                        <span class="text-lg font-bold text-blue-700">₹${service.price || '0'}</span>
                                    </div>
                                </div>
                            </a>
                        `;
                        servicesContainer.insertAdjacentHTML('beforeend', serviceCardHtml);
                    });

                    currentSkip += data.services.length;

                    if (!data.hasMore) {
                        loadMoreBtn.style.display = 'none';
                    } else {
                        loadMoreBtn.textContent = 'View More Services';
                        loadMoreBtn.disabled = false;
                    }

                } catch (error) {
                    console.error('Error loading more services:', error);
                    loadMoreBtn.textContent = 'Error Loading';
                    loadMoreBtn.disabled = false;
                }
            });
        }
    </script>
</body>
</html>
