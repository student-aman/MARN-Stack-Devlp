<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="/style.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body class="bg-gradient-to-br from-blue-50 to-red-100 font-sans antialiased text-gray-800">
    <%- include('partials/header', { currentUser: currentUser }) %>

    <main class="container mx-auto px-4 py-12 md:py-16">
        <div class="max-w-3xl mx-auto bg-white p-8 md:p-10 rounded-2xl border border-blue-100 shadow-lg transition-all duration-300 hover:shadow-2xl">
            <h1 class="text-4xl md:text-5xl font-extrabold text-center text-red-700 mb-8 flex items-center justify-center">
                <i class="fas fa-calendar-check mr-4 text-red-500"></i> Edit Booking
            </h1>
            <p class="text-lg text-center text-gray-600 mb-8">
                Update the booking information.
            </p>

            <% if (errorMessage) { %>
                <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-lg relative mb-6" role="alert">
                    <strong class="font-bold">Error!</strong>
                    <span class="block sm:inline"><%= errorMessage %></span>
                </div>
            <% } %>
            <% if (successMessage) { %>
                <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded-lg relative mb-6" role="alert">
                    <strong class="font-bold">Success!</strong>
                    <span class="block sm:inline"><%= successMessage %></span>
                </div>
            <% } %>

            <form action="/admin/bookings/edit/<%= booking._id %>?_method=PUT" method="POST" class="space-y-6">
                <!-- Read-only fields for context -->
                <div>
                    <label for="serviceTitle" class="block text-md font-medium text-gray-700 mb-2">Service Title</label>
                    <input type="text" id="serviceTitle" value="<%= booking.serviceTitle %>" class="w-full p-3 border border-gray-300 rounded-lg bg-gray-50 cursor-not-allowed" disabled>
                </div>
                <div>
                    <label for="vendorName" class="block text-md font-medium text-gray-700 mb-2">Vendor Name</label>
                    <input type="text" id="vendorName" value="<%= booking.vendorName %>" class="w-full p-3 border border-gray-300 rounded-lg bg-gray-50 cursor-not-allowed" disabled>
                </div>
                <div>
                    <label for="customerName" class="block text-md font-medium text-gray-700 mb-2">Customer Name</label>
                    <input type="text" id="customerName" value="<%= booking.customerName %>" class="w-full p-3 border border-gray-300 rounded-lg bg-gray-50 cursor-not-allowed" disabled>
                </div>
                <div>
                    <label for="customerEmail" class="block text-md font-medium text-gray-700 mb-2">Customer Email</label>
                    <input type="email" id="customerEmail" value="<%= booking.customerEmail %>" class="w-full p-3 border border-gray-300 rounded-lg bg-gray-50 cursor-not-allowed" disabled>
                </div>
                <div>
                    <label for="customerPhone" class="block text-md font-medium text-gray-700 mb-2">Customer Phone</label>
                    <input type="tel" id="customerPhone" value="<%= booking.customerPhone %>" class="w-full p-3 border border-gray-300 rounded-lg bg-gray-50 cursor-not-allowed" disabled>
                </div>
                <div>
                    <label for="bookingDate" class="block text-md font-medium text-gray-700 mb-2">Booking Date</label>
                    <input type="text" id="bookingDate" value="<%= new Date(booking.bookingDate).toLocaleDateString('en-IN') %>" class="w-full p-3 border border-gray-300 rounded-lg bg-gray-50 cursor-not-allowed" disabled>
                </div>

                <!-- Editable fields -->
                <div>
                    <label for="preferredDate" class="block text-md font-medium text-gray-700 mb-2">Preferred Date <span class="text-red-500">*</span></label>
                    <input type="date" id="preferredDate" name="preferredDate" class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-400 focus:border-blue-400 transition" value="<%= booking.preferredDate.toISOString().split('T')[0] %>" required>
                </div>
                <div>
                    <label for="message" class="block text-md font-medium text-gray-700 mb-2">Message / Requirements</label>
                    <textarea id="message" name="message" rows="5" class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-400 focus:border-blue-400 transition"><%= booking.message %></textarea>
                </div>
                <div>
                    <label for="status" class="block text-md font-medium text-gray-700 mb-2">Status <span class="text-red-500">*</span></label>
                    <select id="status" name="status" class="w-full p-3 border border-gray-300 rounded-lg bg-white focus:ring-2 focus:ring-blue-400 focus:border-blue-400 transition" required>
                        <option value="Pending" <%= booking.status === 'Pending' ? 'selected' : '' %>>Pending</option>
                        <option value="Confirmed" <%= booking.status === 'Confirmed' ? 'selected' : '' %>>Confirmed</option>
                        <option value="Cancelled" <%= booking.status === 'Cancelled' ? 'selected' : '' %>>Cancelled</option>
                        <option value="Completed" <%= booking.status === 'Completed' ? 'selected' : '' %>>Completed</option>
                    </select>
                </div>
                
                <button type="submit" class="w-full bg-gradient-to-r from-red-500 to-red-700 text-white font-bold py-4 rounded-lg shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 hover:scale-105 flex items-center justify-center text-xl">
                    <i class="fas fa-save mr-3"></i> Update
                </button>
            </form>

            <div class="mt-8 text-center">
                <a href="/admin/bookings" class="inline-block bg-gray-200 text-gray-700 font-bold py-2 px-6 rounded-full hover:bg-gray-300 transition-colors">
                    <i class="fas fa-arrow-left mr-2"></i> Back to Bookings
                </a>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
