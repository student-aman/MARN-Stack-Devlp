<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="/style.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body class="bg-gray-50 antialiased text-gray-900 font-inter">
  <%- include('partials/header') %>

  <main class="container mx-auto px-4 py-8 md:py-12">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Left Column: Service Details -->
      <div class="lg:col-span-2 space-y-8">
        <!-- Service Main Details Card -->
        <div class="bg-white rounded-3xl shadow-xl border border-gray-200 transition-transform duration-300 hover:-translate-y-1 hover:shadow-2xl overflow-hidden p-8 animate-fadeIn" style="animation-delay: 0.1s;">
          <img src="<%= service.imageUrl || 'https://placehold.co/800x450/E0F2F7/0284C7?text=Service+Image' %>" 
             alt="<%= service.title %>" class="w-full h-96 object-cover object-center rounded-xl mb-6 shadow-xl">
          
          <h1 class="text-4xl md:text-5xl font-extrabold text-blue-800 mb-4 leading-tight">
            <%= service.title %>
          </h1>
          <p class="text-gray-700 text-lg mb-4 leading-relaxed">
            <%= service.description %>
          </p>
          
          <div class="flex items-center text-amber-500 mb-6">
            <div class="star-rating text-xl mr-2">
              <% for(let i = 0; i < Math.floor(service.rating || 4.5); i++) { %>
                <i class="fas fa-star"></i>
              <% } %>
              <% if (service.rating && service.rating % 1 !== 0) { %>
                <i class="fas fa-star-half-alt"></i>
              <% } %>
              <% for(let i = 0; i < (5 - Math.ceil(service.rating || 4.5)); i++) { %>
                <i class="far fa-star"></i>
              <% } %>
            </div>
            <span class="text-gray-700 text-lg font-semibold"><%= service.rating || '4.5' %></span>
            <span class="text-gray-500 text-md ml-3">(<%= service.reviewsCount || '120' %> Reviews)</span>
            <a href="#reviews" class="text-blue-600 hover:underline text-md ml-4">Sabhi Reviews Dekhein</a>
          </div>

          <div class="bg-blue-50 p-6 rounded-xl flex items-center space-x-4 shadow-inner">
            <img src="<%= service.vendorImage || 'https://placehold.co/60x60/D1E9F9/2196F3?text=V' %>" 
               alt="<%= service.vendorName %>" class="w-16 h-16 rounded-full object-cover object-center border-2 border-blue-300 shadow-md">
            <div>
              <p class="text-blue-800 font-bold text-xl"><%= service.vendorName %></p>
              <p class="text-gray-600 text-sm"><%= service.vendorExpertise || 'IT Tech Expert' %></p>
            </div>
          </div>
        </div>

        <!-- Service Viveran (Detailed Description) -->
        <div class="bg-white rounded-3xl shadow-xl border border-gray-200 transition-transform duration-300 hover:-translate-y-1 hover:shadow-2xl overflow-hidden p-8 animate-fadeIn" style="animation-delay: 0.2s;">
          <h2 class="text-3xl font-bold text-gray-800 mb-6 border-b-2 border-blue-200 pb-3">Service Viveran</h2>
          <p class="text-gray-700 leading-relaxed mb-4">
            <%= service.longDescription || service.description %>
          </p>
          <p class="text-gray-700 leading-relaxed">
            Main latest technologies aur best practices ka use karta hoon taaki aapki service top-notch ho. Delivery se pehle testing aur revision shamil hain.
          </p>
        </div>

        <!-- Why This Service is Best? -->
        <div class="bg-white rounded-3xl shadow-xl border border-gray-200 transition-transform duration-300 hover:-translate-y-1 hover:shadow-2xl overflow-hidden p-8 animate-fadeIn" style="animation-delay: 0.3s;">
          <h2 class="text-3xl font-bold text-gray-800 mb-6 border-b-2 border-blue-200 pb-3">Ye Service Best Kyon Hai?</h2>
          <ul class="list-disc list-inside text-gray-700 space-y-3">
            <li><i class="fas fa-check-circle text-green-500 mr-2"></i> Quality, reliability aur satisfaction ke saath aapko milega seamless experience.</li>
            <li><i class="fas fa-headset text-blue-500 mr-2"></i> Support milega design se deployment tak.</li>
            <li><i class="fas fa-cogs text-gray-500 mr-2"></i> Latest tools aur techniques ka upyog.</li>
            <li><i class="fas fa-clock text-purple-500 mr-2"></i> Samay par delivery aur efficient communication.</li>
          </ul>
        </div>
      </div>

      <!-- Right Column: Provider Details & Actions -->
      <div class="lg:col-span-1 space-y-8">
        <!-- Provider Details Card -->
        <div class="bg-white rounded-3xl shadow-xl border border-gray-200 transition-transform duration-300 hover:-translate-y-1 hover:shadow-2xl overflow-hidden p-8 animate-fadeIn" style="animation-delay: 0.4s;">
          <h2 class="text-2xl font-bold text-gray-800 mb-6 border-b-2 border-blue-200 pb-3">Provider Details</h2>
          <img src="<%= service.vendorImage || 'https://placehold.co/100x100/D1E9F9/2196F3?text=V' %>" 
             alt="<%= service.vendorName %>" class="w-24 h-24 rounded-full object-cover object-center mx-auto mb-4 border-4 border-blue-400 shadow-lg">
          <h3 class="text-2xl font-bold text-blue-800 flex items-center justify-center"><%= service.vendorName %> <i class="fas fa-check-circle text-blue-500 text-lg ml-1"></i></h3>
          <p class="text-gray-600 text-sm mb-4 text-center"><%= service.vendorExpertise || 'IT Tech Expert' %></p>
          
          <div class="flex items-center justify-center text-amber-500 mb-4">
            <div class="star-rating text-lg mr-2">
              <% for(let i = 0; i < Math.floor(service.rating || 4.9); i++) { %>
                <i class="fas fa-star"></i>
              <% } %>
              <% if (service.rating && service.rating % 1 !== 0) { %>
                <i class="fas fa-star-half-alt"></i>
              <% } %>
              <% for(let i = 0; i < (5 - Math.ceil(service.rating || 4.9)); i++) { %>
                <i class="far fa-star"></i>
              <% } %>
            </div>
            <span class="text-gray-700 font-semibold"><%= service.rating || '4.9' %></span>
            <span class="text-gray-500 text-sm ml-2">(<%= service.reviewsCount || '120' %>)</span>
          </div>

          <div class="text-gray-700 text-left space-y-3 mb-6">
            <p class="flex items-center"><i class="fas fa-map-marker-alt text-blue-500 mr-3"></i> <%= service.location || 'Ludhiana' %></p>
            <p class="flex items-center"><i class="fas fa-calendar-alt text-blue-500 mr-3"></i> Joined: <%= new Date(service.joinedDate || '2020-01-01').toLocaleDateString('en-IN', { month: 'short', year: 'numeric' }) %></p>
            <p class="flex items-center"><i class="fas fa-project-diagram text-blue-500 mr-3"></i> <%= service.projectsCompleted || '250+' %> Projects</p>
          </div>

          <div class="space-y-4">
            <a href="/book-service/<%= service.id %>" class="flex items-center justify-center w-full px-7 py-4 rounded-xl font-bold uppercase tracking-wide bg-emerald-500 text-white shadow-md hover:bg-emerald-600 hover:-translate-y-1 hover:shadow-lg transition-all duration-300">
              <i class="fas fa-calendar-check mr-3 text-lg"></i> Service Book Karein
            </a>
            <a href="/contact?vendor=<%= service.vendorName %>" class="flex items-center justify-center w-full px-7 py-4 rounded-xl font-bold uppercase tracking-wide bg-indigo-500 text-white shadow-md hover:bg-indigo-600 hover:-translate-y-1 hover:shadow-lg transition-all duration-300">
              <i class="fas fa-comments mr-3 text-lg"></i> Provider se Sampark Karein
            </a>
            <button class="flex items-center justify-center w-full px-7 py-4 rounded-xl font-bold uppercase tracking-wide bg-amber-400 text-amber-900 shadow-md hover:bg-amber-500 hover:-translate-y-1 hover:shadow-lg transition-all duration-300">
              <i class="fas fa-heart mr-3 text-lg"></i> Wishlist mein Add Karein
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Customer Reviews Section -->
    <section id="reviews" class="bg-white rounded-3xl shadow-xl border border-gray-200 mt-12 p-8 md:p-10 animate-fadeIn" style="animation-delay: 0.5s;">
      <h2 class="text-3xl font-bold text-gray-800 mb-8 text-center border-b-2 border-blue-200 pb-3">Customer Reviews (<%= reviews.length %>)</h2>
      <% if (reviews && reviews.length > 0) { %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <% reviews.forEach(review => { %>
            <div class="bg-white p-6 rounded-xl shadow-md border border-gray-100 flex items-start space-x-4 transition-transform duration-200 hover:-translate-y-1 hover:shadow-lg">
              <img src="<%= review.customerImage %>" alt="<%= review.customerName %>" class="w-16 h-16 rounded-full object-cover object-center border-2 border-gray-200 shadow-sm">
              <div class="flex-1">
                <h4 class="text-lg font-semibold text-gray-800"><%= review.customerName %></h4>
                <div class="star-rating text-amber-400 text-sm mb-2 flex items-center">
                  <% for(let i = 0; i < Math.floor(review.rating); i++) { %>
                    <i class="fas fa-star"></i>
                  <% } %>
                  <% if (review.rating % 1 !== 0) { %>
                    <i class="fas fa-star-half-alt"></i>
                  <% } %>
                  <% for(let i = 0; i < (5 - Math.ceil(review.rating)); i++) { %>
                    <i class="far fa-star"></i>
                  <% } %>
                  <span class="ml-2 text-gray-600 text-xs"><%= new Date(review.date).toLocaleDateString() %></span>
                </div>
                <p class="text-gray-700 leading-relaxed"><%= review.comment %></p>
              </div>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <p class="text-center text-gray-600 py-4 text-lg">Is service ke liye abhi koi review nahi hai.</p>
      <% } %>
    </section>

    <!-- Similar Services Section -->
    <section class="bg-white rounded-3xl shadow-xl border border-gray-200 mt-12 p-8 md:p-10 animate-fadeIn" style="animation-delay: 0.6s;">
      <h2 class="text-3xl font-bold text-gray-800 mb-8 text-center border-b-2 border-blue-200 pb-3">Similar Services</h2>
      <% if (similarServices && similarServices.length > 0) { %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <% similarServices.forEach(simService => { %>
            <a href="/service/<%= simService.id %>" class="block bg-white rounded-2xl shadow-md border border-gray-100 p-6 text-center transition-transform duration-200 hover:-translate-y-1 hover:shadow-lg">
              <img src="<%= simService.imageUrl || 'https://placehold.co/400x225/E0F2F7/0284C7?text=Service+Image' %>" 
                 alt="<%= simService.title %>" class="w-full h-40 object-cover object-center rounded-lg mb-4 shadow-sm">
              <h3 class="text-xl font-semibold text-blue-700 mb-2"><%= simService.title %></h3>
              <p class="text-gray-600 text-sm mb-3"><%= simService.vendorName %></p>
              <div class="flex items-center justify-center text-amber-500 mb-2">
                <div class="star-rating text-sm mr-1">
                  <% for(let i = 0; i < Math.floor(simService.rating || 4.0); i++) { %>
                    <i class="fas fa-star"></i>
                  <% } %>
                  <% if (simService.rating && simService.rating % 1 !== 0) { %>
                    <i class="fas fa-star-half-alt"></i>
                  <% } %>
                  <% for(let i = 0; i < (5 - Math.ceil(simService.rating || 4.0)); i++) { %>
                    <i class="far fa-star"></i>
                  <% } %>
                </div>
                <span class="text-gray-700 text-sm"><%= simService.rating || '4.0' %></span>
              </div>
              <p class="text-blue-800 font-bold text-lg">₹<%= simService.price %></p>
            </a>
          <% }); %>
        </div>
      <% } else { %>
        <p class="text-center text-gray-600 py-4 text-lg">Koi similar service nahi mili.</p>
      <% } %>
    </section>

  </main>

  <%- include('partials/footer') %>
  <style>
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(20px);}
      to { opacity: 1; transform: translateY(0);}
    }
    .animate-fadeIn {
      animation: fadeIn 0.8s ease-out forwards;
      opacity: 0;
    }
    .font-inter {
      font-family: 'Inter', sans-serif;
    }
  </style>
</body>
</html>
